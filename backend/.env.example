PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=codearena
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Judge
JUDGE_TIMEOUT=10
JUDGE_MEMORY_LIMIT=256

# Judge0 API (get free key from rapidapi.com/judge0-official/api/judge0-ce)
JUDGE0_API_KEY=your_judge0_rapidapi_key
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
